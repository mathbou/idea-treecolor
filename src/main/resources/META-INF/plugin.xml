<idea-plugin>
    <id>fr.mathbou.treecolor</id>
    <name>Project Tree Color Highlighter</name>
    <version>@version@</version>
    <vendor url="https://github.com/mathbou">Mathieu Bouzard</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <editorTabColorProvider implementation="fr.mathbou.treecolor.providers.ColorProvider" order="first"/>
        <projectService serviceImplementation="fr.mathbou.treecolor.services.ProjectStateService"/>
        <applicationService serviceImplementation="fr.mathbou.treecolor.services.AppStateService"/>
    </extensions>

    <actions>
        <group id="actions.fr.mathbou.treecolor.HighlightActionGroup"
               class="fr.mathbou.treecolor.actions.HighlightActionGroup"
               text="Highlight" description="Highlight your project files and folders"
               icon="/icons/highlight.png" popup="true">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="popup@ExpandableBookmarkContextMenu"/>
            <add-to-group group-id="EditorTabPopupMenuEx" anchor="after" relative-to-action="popup@ExpandableBookmarkContextMenu"/>
        </group>
    </actions>

</idea-plugin>
